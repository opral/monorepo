{
	"name": "@inlang/plugin-next-intl",
	"version": "2.2.2",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"./dist",
		"./assets"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/opral/inlang",
		"directory": "packages/plugins/next-intl"
	},
	"scripts": {
		"dev": "node ./build.js",
		"build": "NODE_ENV=production node ./build.js",
		"test": "tsc --noEmit && vitest run --passWithNoTests --coverage",
		"format": "prettier ./src --write",
		"clean": "rm -rf ./dist ./node_modules"
	},
	"dependencies": {
		"@sinclair/typebox": "0.31.28",
		"@inlang/sdk": "workspace:*"
	},
	"devDependencies": {
		"@formatjs/icu-messageformat-parser": "3.5.18",
		"@inlang/plugin-icu1": "workspace:*",
		"@messageformat/parser": "^5.1.1",
		"@inlang/tsconfig": "workspace:*",
		"@types/flat": "^5.0.2",
		"@types/lodash.merge": "^4.6.7",
		"@types/parsimmon": "1.10.6",
		"esbuild": "^0.24.2",
		"flat": "^5.0.2",
		"intl-messageformat": "11.2.15",
		"parsimmon": "^1.18.1",
		"typescript": "^5.5.2",
		"vitest": "3.1.1",
		"@vitest/coverage-v8": "3.1.1",
		"memfs": "4.6.0"
	}
}
